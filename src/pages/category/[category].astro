---
import BaseLayout from '../../layouts/BaseLayout.astro'
import data from '../../data/articles.json'
import { CATEGORY_LABELS } from '../../data/navigation'
import {
  absoluteUrl,
  buildCategorySchemaGraph,
  buildFaqSchemaGraph,
  truncateMeta,
  type FaqItem,
} from '../../lib/seo'

export function getStaticPaths() {
  return data.categories.map((c) => ({
    params: { category: c.slug },
  }))
}

const { category } = Astro.params
const cat = data.categories.find((c) => c.slug === category)
if (!cat) {
  return Astro.redirect('/')
}

const title = CATEGORY_LABELS[category] ?? cat.slug
const lang = 'fr'
const catPath = `/category/${category}/`
const catUrl = absoluteUrl(catPath)

type CategorySeo = {
  pageTitle: string
  metaDescription: string
  introHtml?: string
  faq?: FaqItem[]
}

const CATEGORY_SEO: Record<string, CategorySeo> = {
  'adresses-utiles': {
    pageTitle: 'Adresses utiles à Phuket',
    metaDescription:
      'Adresses utiles à Phuket : urgences, hôpitaux, administrations, école française et associations pour expatriés francophones.',
    introHtml:
      '<p>Retrouvez les <strong>adresses utiles à Phuket</strong> pour les expatriés francophones : immigration, hôpitaux, numéros d’urgence, consulat, école française et ostéopathe. Ces fiches complètent nos services <a href="/interprete-thai-francais-anglais-a-phuket/">interprète</a> et <a href="/assurance-sante-thailande-phuket/">assurance santé</a>.</p>',
  },
  'les-bonnes-adresses-francophones': {
    pageTitle: 'Bonnes adresses francophones Phuket',
    metaDescription:
      'Hôtels, commerçants, loueurs et activités nautiques à Phuket : sélection de bonnes adresses francophones.',
    introHtml:
      '<p>Notre sélection de <strong>bonnes adresses francophones à Phuket</strong> : hôtels, commerçants, location de scooters et activités nautiques. Idéal pour préparer un séjour ou une installation sur l’île.</p>',
  },
  'assurance-sante-et-biens-en-thailande': {
    pageTitle: 'Assurance santé Phuket & Thaïlande',
    metaDescription:
      'Guides assurance santé à Phuket et en Thaïlande : AXA, hospitalisation, auto et habitation pour expatriés francophones.',
    introHtml:
      '<p>Guides <strong>assurance santé Phuket et Thaïlande</strong> pour expatriés : comparatif des besoins, offres AXA et conseils en français. <a href="/formulaire-de-contact/">Demandez un devis personnalisé</a>.</p>',
    faq: [
      {
        question: 'Quelle assurance santé pour un expatrié à Phuket ?',
        answer:
          'Une couverture hospitalisation et ambulatoire adaptée à votre visa, avec plafonds suffisants pour les cliniques privées de Phuket.',
      },
      {
        question: 'AXA est-il disponible en français ?',
        answer:
          'Oui, via KrungThai AXA avec accompagnement francophone pour la souscription et les sinistres.',
      },
    ],
  },
  'services-expatriation-en-thailande': {
    pageTitle: 'Expatriation & immobilier Phuket',
    metaDescription:
      'Immobilier à Phuket et Krabi, maison à vendre, location et services d’expatriation pour francophones.',
    introHtml:
      '<p><strong>Expatriation à Phuket</strong> : immobilier (achat, location), interprète et assurance. Thomas vous guide pour une <a href="/expatriation-a-phuket-besoin-achat-immobilier-ou-locatif/">maison à vendre ou à louer</a> ; Tammy pour la santé et les urgences.</p>',
  },
}
const catSeo = category ? CATEGORY_SEO[category] : undefined
const pageTitle = catSeo?.pageTitle ?? title
const metaDesc = truncateMeta(
  catSeo?.metaDescription ??
    `Guides et adresses utiles pour les francophones à Phuket : ${title}.`,
  160,
)
const articleUrls = cat.posts.map((p) => absoluteUrl(`/${p.slug}/`))
const catFaq = catSeo?.faq ?? []
const jsonLdExtra = [
  ...buildCategorySchemaGraph({
    name: title,
    description: metaDesc,
    url: catUrl,
    articleUrls,
  }),
  ...buildFaqSchemaGraph(catFaq),
]
---

<BaseLayout
  lang={lang}
  pageTitle={pageTitle}
  metaDescription={metaDesc}
  canonicalPath={catPath}
  jsonLdExtra={jsonLdExtra}
>
  <div class="category-page">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span class="bc-sep" aria-hidden="true">/</span>
        <span class="bc-current">{title}</span>
      </nav>
      <header class="cat-header">
        <h1>{title}</h1>
        <p class="cat-count">{cat.posts.length} article{cat.posts.length > 1 ? 's' : ''}</p>
      </header>
      {catSeo?.introHtml && (
        <div class="cat-intro wp-import" set:html={catSeo.introHtml} />
      )}
      {catFaq.length > 0 && (
        <section class="cat-faq" aria-labelledby="cat-faq-title">
          <h2 id="cat-faq-title">Questions fréquentes</h2>
          <dl class="faq-list">
            {catFaq.map((item) => (
              <>
                <dt>{item.question}</dt>
                <dd>{item.answer}</dd>
              </>
            ))}
          </dl>
        </section>
      )}
      <ul class="post-list">
        {cat.posts.map((p) => (
          <li>
            <a href={`/${p.slug}/`} class="post-card">
              <span class="post-title">{p.title}</span>
              {p.excerpt && <span class="post-excerpt">{p.excerpt}…</span>}
              <time datetime={p.date}>
                {new Date(p.date).toLocaleDateString('fr-FR', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .category-page {
    padding-block: clamp(2rem, 5vw, 3.5rem);
    background: var(--color-cream);
    min-height: 50vh;
  }

  .breadcrumb {
    font-size: 0.88rem;
    margin-bottom: 1.5rem;
    color: var(--color-ink-muted);
  }

  .breadcrumb a {
    color: var(--color-ocean);
    font-weight: 500;
  }

  .bc-sep {
    margin: 0 0.4rem;
    opacity: 0.6;
  }

  .cat-header {
    margin-bottom: 2rem;
  }

  .cat-header h1 {
    color: var(--color-ocean);
    font-size: clamp(1.65rem, 4vw, 2.1rem);
  }

  .cat-count {
    margin-top: 0.35rem;
    color: var(--color-ink-muted);
    font-size: 0.95rem;
  }

  .cat-intro {
    margin-bottom: 1.75rem;
    padding: 1.15rem 1.25rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 52rem;
  }

  .cat-intro :global(a) {
    color: var(--color-ocean);
    font-weight: 600;
  }

  .cat-faq {
    margin-bottom: 2rem;
    max-width: 52rem;
  }

  .cat-faq h2 {
    font-size: 1.25rem;
    color: var(--color-ocean);
    margin-bottom: 1rem;
  }

  .faq-list {
    margin: 0;
  }

  .faq-list dt {
    font-weight: 700;
    margin-top: 0.85rem;
  }

  .faq-list dd {
    margin: 0.3rem 0 0;
    color: var(--color-ink-soft);
    line-height: 1.6;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.15rem 1.25rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .post-card:hover {
    border-color: var(--color-ocean);
    box-shadow: var(--shadow-md);
  }

  .post-title {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-ocean);
  }

  .post-excerpt {
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  .post-card time {
    font-size: 0.82rem;
    color: var(--color-ink-muted);
  }
</style>
