---
import BaseLayout from '../layouts/BaseLayout.astro'
import Contact from '../components/Contact.astro'
import data from '../data/articles.json'
import articleOverrides from '../data/article-overrides.json'
import { htmlHasEmbeddedForm, stripEmbeddedHtmlForms } from '../lib/article-html'
import { rewriteInternalLinks } from '../lib/internal-links'
import { absoluteUrl, buildArticleSchemaGraph, truncateMeta } from '../lib/seo'

export function getStaticPaths() {
  return data.articles.map((a) => ({
    params: { slug: a.slug },
  }))
}

const { slug } = Astro.params
const article = data.articles.find((a) => a.slug === slug)
if (!article) {
  return Astro.redirect('/')
}

const hadEmbeddedForm = htmlHasEmbeddedForm(article.content)
type ArticleOverride = { appendContactForm?: boolean }
const slugOverride =
  (articleOverrides as Record<string, ArticleOverride>)[slug ?? ''] ?? {}
const appendContactForm = Boolean(slugOverride.appendContactForm)
const showContactBlock = hadEmbeddedForm || appendContactForm
const html = rewriteInternalLinks(stripEmbeddedHtmlForms(article.content))
const lang = 'fr'
const excerpt = truncateMeta(article.excerpt)
const articleUrl = absoluteUrl(`/${slug}/`)
const jsonLdExtra = buildArticleSchemaGraph({
  headline: article.title,
  description: article.excerpt,
  datePublished: article.date,
  url: articleUrl,
})
---

<BaseLayout
  lang={lang}
  pageTitle={article.title}
  metaDescription={excerpt}
  canonicalPath={`/${slug}/`}
  ogType="article"
  articlePublishedTime={article.date}
  jsonLdExtra={jsonLdExtra}
>
  <article class="article-page">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span class="bc-sep" aria-hidden="true">/</span>
        <span class="bc-current">{article.title}</span>
      </nav>
      <header class="article-header">
        <h1>{article.title}</h1>
        <time class="article-date" datetime={article.date}>
          {new Date(article.date).toLocaleDateString('fr-FR', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </header>
      <div class="article-body wp-import" set:html={html} />
    </div>
    {showContactBlock && <Contact lang={lang} />}
  </article>
</BaseLayout>

<style>
  .article-page {
    padding-block: clamp(2rem, 5vw, 3.5rem);
    background: var(--color-cream);
    min-height: 50vh;
  }

  .breadcrumb {
    font-size: 0.88rem;
    margin-bottom: 1.5rem;
    color: var(--color-ink-muted);
  }

  .breadcrumb a {
    color: var(--color-ocean);
    font-weight: 500;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .bc-sep {
    margin: 0 0.4rem;
    opacity: 0.6;
  }

  .bc-current {
    color: var(--color-ink-soft);
  }

  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-header h1 {
    color: var(--color-ocean);
    font-size: clamp(1.65rem, 4vw, 2.25rem);
    margin-bottom: 0.5rem;
  }

  .article-date {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
  }

  .article-body {
    max-width: 900px;
  }
</style>
