---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  actualiteHref,
  formatActualiteDate,
  getPublishedActualites,
  type ActualiteEntry,
} from '../../lib/actualites'
import { absoluteAssetUrl, absoluteUrl, buildArticleSchemaGraph, truncateMeta } from '../../lib/seo'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getPublishedActualites()
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

interface Props {
  post: ActualiteEntry
}

const { post } = Astro.props
const { Content } = await render(post)
const lang = 'fr'
const pageTitle = post.data.title
const pageH1 = post.data.title
const metaDescription = truncateMeta(post.data.description, 160)
const articlePath = actualiteHref(post)
const articleUrl = absoluteUrl(articlePath)
const allPosts = await getPublishedActualites()
const related = allPosts.filter((p) => p.id !== post.id).slice(0, 3)

const jsonLdExtra = buildArticleSchemaGraph({
  headline: pageH1,
  description: metaDescription,
  datePublished: post.data.pubDate.toISOString(),
  url: articleUrl,
  imageUrl: post.data.image ? absoluteAssetUrl(post.data.image) : undefined,
})
---

<BaseLayout
  lang={lang}
  pageTitle={pageTitle}
  metaDescription={metaDescription}
  canonicalPath={articlePath}
  ogType="article"
  articlePublishedTime={post.data.pubDate.toISOString()}
  jsonLdExtra={jsonLdExtra}
>
  <article class="actualite-article">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span class="bc-sep" aria-hidden="true">/</span>
        <a href="/actualites/">Actualités</a>
        <span class="bc-sep" aria-hidden="true">/</span>
        <span class="bc-current">{pageH1}</span>
      </nav>

      <header class="article-header">
        <h1>{pageH1}</h1>
        <time class="article-date" datetime={post.data.pubDate.toISOString()}>
          {formatActualiteDate(post.data.pubDate)}
        </time>
      </header>

      {post.data.image && (
        <figure class="article-cover">
          <img src={post.data.image} alt={pageH1} width="900" height="500" loading="eager" />
        </figure>
      )}

      <div class="article-body wp-import">
        <Content />
      </div>

      {related.length > 0 && (
        <nav class="related-actualites" aria-labelledby="related-actualites-title">
          <h2 id="related-actualites-title">Autres actualités</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={actualiteHref(r)}>{r.data.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <p class="back-link">
        <a href="/actualites/">← Toutes les actualités</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .actualite-article {
    padding-block: clamp(2rem, 5vw, 3.5rem);
    background: var(--color-cream);
    min-height: 50vh;
  }

  .breadcrumb {
    font-size: 0.88rem;
    margin-bottom: 1.5rem;
    color: var(--color-ink-muted);
  }

  .breadcrumb a {
    color: var(--color-ocean);
    font-weight: 500;
  }

  .bc-sep {
    margin: 0 0.4rem;
    opacity: 0.6;
  }

  .bc-current {
    color: var(--color-ink-soft);
  }

  .article-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-header h1 {
    color: var(--color-ocean);
    font-size: clamp(1.65rem, 4vw, 2.25rem);
    margin-bottom: 0.5rem;
  }

  .article-date {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
  }

  .article-cover {
    margin-bottom: 1.75rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    max-width: 900px;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-body {
    max-width: 900px;
  }

  .related-actualites {
    max-width: 900px;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .related-actualites h2 {
    font-size: 1.15rem;
    color: var(--color-ocean);
    margin-bottom: 0.75rem;
  }

  .related-actualites ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .related-actualites a {
    color: var(--color-ocean);
    font-weight: 600;
  }

  .back-link {
    margin-top: 2rem;
    max-width: 900px;
  }

  .back-link a {
    color: var(--color-ocean);
    font-weight: 600;
  }
</style>
