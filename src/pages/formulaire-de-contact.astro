---
import BaseLayout from '../layouts/BaseLayout.astro'
import Contact from '../components/Contact.astro'
import { translations } from '../i18n/translations'
import { SITE } from '../config'
import { truncateMeta } from '../lib/seo'

const lang = 'fr' as const
const t = translations[lang]
const pageTitle = 'Formulaire de contact'
const metaDescription = truncateMeta(
  `${t.contact.title}. ${t.contact.subtitle} ${SITE.name}, Phuket.`,
  170,
)
---

<BaseLayout
  lang={lang}
  pageTitle={pageTitle}
  metaDescription={metaDescription}
  canonicalPath="/formulaire-de-contact/"
>
  <div class="contact-page-wrap">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span class="bc-sep" aria-hidden="true">/</span>
        <span class="bc-current">{pageTitle}</span>
      </nav>
    </div>
    <Contact lang={lang} />
  </div>
</BaseLayout>

<style>
  .contact-page-wrap {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-gold) 8%, transparent) 0%,
      var(--color-sand-light) 100%
    );
    min-height: 60vh;
  }

  .breadcrumb {
    font-size: 0.88rem;
    padding-block: 1.25rem 0;
    color: var(--color-ink-muted);
  }

  .breadcrumb a {
    color: var(--color-ocean);
    font-weight: 500;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .bc-sep {
    margin-inline: 0.35rem;
  }

  .bc-current {
    color: var(--color-ink-soft);
  }
</style>
