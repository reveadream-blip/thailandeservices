---
import BaseLayout from '../layouts/BaseLayout.astro'
import Contact from '../components/Contact.astro'
import { translations } from '../i18n/translations'
import { SITE } from '../config'
import { truncateMeta } from '../lib/seo'

const lang = 'fr' as const
const t = translations[lang]
const pageTitle = 'Contact assurance, immo & interprète'
const metaDescription = truncateMeta(
  `Contactez ${SITE.name} : assurance santé Phuket et Thaïlande, interprète thaï français anglais, immobilier Phuket & Krabi.`,
  160,
)
const pageH1 = 'Contact — assurance, immobilier et interprète à Phuket'
---

<BaseLayout
  lang={lang}
  pageTitle={pageTitle}
  metaDescription={metaDescription}
  canonicalPath="/formulaire-de-contact/"
>
  <div class="contact-page-wrap">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span class="bc-sep" aria-hidden="true">/</span>
        <span class="bc-current">Formulaire de contact</span>
      </nav>
      <h1 class="contact-page-h1">{pageH1}</h1>
    </div>
    <Contact lang={lang} />
  </div>
</BaseLayout>

<style>
  .contact-page-wrap {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-gold) 8%, transparent) 0%,
      var(--color-sand-light) 100%
    );
    min-height: 60vh;
  }

  .breadcrumb {
    font-size: 0.88rem;
    padding-block: 1.25rem 0;
    color: var(--color-ink-muted);
  }

  .breadcrumb a {
    color: var(--color-ocean);
    font-weight: 500;
  }

  .contact-page-h1 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2rem);
    color: var(--color-ocean);
    margin: 0.75rem 0 0;
    line-height: 1.2;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .bc-sep {
    margin-inline: 0.35rem;
  }

  .bc-current {
    color: var(--color-ink-soft);
  }
</style>
