---
import { translations, type Lang, LANGS, LANG_LABELS } from '../i18n/translations'
import { CONTACT, SITE, contactFormHref } from '../config'
import { MAIN_NAV_FR } from '../data/navigation'
import NavIcon from './NavIcon.astro'

export interface Props {
  lang: Lang
  /** Défaut : logo standard ; page d’accueil peut surcharger (ex. `/images/logo-home.png`). */
  logoSrc?: string
}

const { lang, logoSrc = '/images/logo.png' } = Astro.props
const t = translations[lang]

const localeHref = (target: Lang) => (target === 'fr' ? '/' : `/${target}/`)
---

<header class="site-header">
  <a href="#main-content" class="skip-link">{t.nav.skipContent}</a>

  <!-- Ligne 1 : logo aligné à gauche, actions alignées à droite -->
  <div class="header-top">
    <div class="container header-top-inner">
      <a href={localeHref(lang)} class="logo" aria-label={SITE.name}>
        <img src={logoSrc} width="512" height="512" alt="" class="logo-img" />
        <span class="logo-meta">
          <span class="logo-title">{SITE.name}</span>
          <span class="logo-tagline">{SITE.tagline}</span>
        </span>
      </a>

      <div class="header-actions">
        <div class="lang-switch" role="group" aria-label="Langue">
          {LANGS.map((l) => (
            <a
              href={localeHref(l)}
              class:list={['lang-btn', { active: l === lang }]}
              aria-current={l === lang ? 'true' : undefined}
            >
              {LANG_LABELS[l]}
            </a>
          ))}
        </div>

        <a href={CONTACT.whatsappLink} target="_blank" rel="noopener" class="btn btn-whatsapp btn-sm header-wa">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1s-.5-.2-.6.2c-.2.3-.7 1-.9 1.2s-.3.2-.6.1c-.3-.2-1.2-.5-2.3-1.4-.8-.7-1.4-1.6-1.6-1.9s0-.4.1-.6c.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5s0-.4 0-.5-.6-1.5-.9-2.1c-.2-.5-.5-.4-.6-.4h-.6c-.2 0-.5 0-.8.3s-1 1-1 2.4 1 2.8 1.2 3 2.1 3.2 5 4.5c.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.2-.1-.4-.2-.6-.4zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.3c1.4.8 3.1 1.2 4.8 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z" />
          </svg>
          <span class="wa-num">{CONTACT.phoneDisplay}</span>
        </a>

        <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Ligne 2 : menu desktop pleine largeur (évite le chevauchement logo / liens) -->
  <div class="header-nav-desktop">
    <div class="container">
      <nav class="nav-desktop" aria-label="Navigation principale">
        {MAIN_NAV_FR.map((item) => (
          <div class:list={['nav-item', `nav-item--${item.icon}`]}>
            <a href={item.href} class="nav-top">
              <span class="nav-icon-wrap">
                <NavIcon name={item.icon} size={18} />
              </span>
              <span class="nav-top-main">
                <span class="nav-top-text">{item.label}</span>
                {item.children && item.children.length > 0 && (
                  <svg class="nav-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                )}
              </span>
            </a>
            {item.children && item.children.length > 0 && (
              <ul class="submenu" role="list">
                {item.children.map((sub) => (
                  <li>
                    <a href={sub.href}>
                      <span class="submenu-dot" aria-hidden="true" />
                      <span>{sub.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
        <a href={contactFormHref(lang)} class="nav-cta" title={t.nav.contactForm}>
          <span class="nav-icon-wrap nav-icon-wrap--cta">
            <NavIcon name="mail" size={17} />
          </span>
          <span>{t.nav.menuContact}</span>
        </a>
      </nav>
    </div>
  </div>

  <nav class="nav-mobile" id="nav-mobile" aria-label="Navigation mobile" hidden>
    {MAIN_NAV_FR.map((item) => (
      <details class:list={['mobile-group', `mobile-group--${item.icon}`]}>
        <summary>
          <span class="mobile-summary-row">
            <span class="nav-icon-wrap nav-icon-wrap--mobile">
              <NavIcon name={item.icon} size={20} />
            </span>
            <span class="mobile-summary-text">{item.label}</span>
          </span>
        </summary>
        <ul role="list">
          <li>
            <a href={item.href}>{t.nav.viewCategory}</a>
          </li>
          {item.children?.map((sub) => (
            <li>
              <a href={sub.href}>{sub.label}</a>
            </li>
          ))}
        </ul>
      </details>
    ))}
    <a href={contactFormHref(lang)} class="mobile-form-link">
      <span class="nav-icon-wrap nav-icon-wrap--cta nav-icon-wrap--mobile-sm">
        <NavIcon name="mail" size={17} />
      </span>
      <span>{t.nav.contactForm}</span>
    </a>
    <a href={CONTACT.whatsappLink} target="_blank" rel="noopener" class="mobile-wa">
      WhatsApp {CONTACT.phoneDisplay}
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')
  const nav = document.getElementById('nav-mobile')
  toggle?.addEventListener('click', () => {
    const isHidden = nav?.hasAttribute('hidden')
    if (isHidden) {
      nav?.removeAttribute('hidden')
      toggle.setAttribute('aria-expanded', 'true')
      toggle.classList.add('is-open')
    } else {
      nav?.setAttribute('hidden', '')
      toggle.setAttribute('aria-expanded', 'false')
      toggle.classList.remove('is-open')
    }
  })
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      nav.setAttribute('hidden', '')
      toggle?.setAttribute('aria-expanded', 'false')
      toggle?.classList.remove('is-open')
    })
  )

  const header = document.querySelector('.site-header')
  const onScroll = () => {
    if (window.scrollY > 10) header?.classList.add('scrolled')
    else header?.classList.remove('scrolled')
  }
  window.addEventListener('scroll', onScroll, { passive: true })
  onScroll()
</script>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    z-index: 200;
    padding: 0.75rem 1rem;
    background: var(--color-ocean);
    color: #fff;
    font-weight: 600;
    border-radius: var(--radius-sm);
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding-top: env(safe-area-inset-top, 0px);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(240, 253, 250, 0.92) 100%);
    backdrop-filter: saturate(200%) blur(16px);
    -webkit-backdrop-filter: saturate(200%) blur(16px);
    transition: box-shadow 0.25s ease, background 0.25s ease;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ocean-light) 20%, var(--color-border));
  }

  .site-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-ocean-light), var(--color-coral), var(--color-gold));
    opacity: 0.95;
    pointer-events: none;
  }

  .site-header.scrolled {
    box-shadow: 0 8px 32px rgba(14, 116, 144, 0.12);
    background: rgba(255, 255, 255, 0.98);
  }

  /* --- Ligne supérieure --- */
  .header-top-inner {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    min-height: 64px;
  }

  .logo {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
    min-width: 0;
    text-decoration: none;
  }

  .logo-img {
    width: auto;
    height: 48px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .logo-meta {
    display: flex;
    flex-direction: column;
    gap: 0.08rem;
    line-height: 1.15;
    min-width: 0;
  }

  .logo-title {
    font-weight: 800;
    font-size: 0.78rem;
    color: var(--color-ocean);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 200px;
  }

  .logo-tagline {
    font-size: 0.65rem;
    color: var(--color-ink-muted);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 220px;
  }

  .header-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .lang-switch {
    display: flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 3px;
    background: #fff;
  }

  .lang-btn {
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .lang-btn.active {
    background: var(--gradient-ocean);
    color: #fff;
    box-shadow: 0 4px 14px rgba(14, 116, 144, 0.35);
  }

  .header-wa {
    padding: 0.5rem 0.85rem;
    font-size: 0.78rem;
    gap: 0.4rem;
  }

  .header-wa .wa-num {
    display: none;
  }

  @media (min-width: 480px) {
    .header-wa .wa-num {
      display: inline;
    }
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    align-items: center;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ocean);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .menu-toggle.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle.is-open span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* --- Barre menu desktop (2e ligne) --- */
  .header-nav-desktop {
    display: none;
    border-top: 1px solid color-mix(in srgb, var(--color-ocean-light) 22%, transparent);
    padding-block: 0.45rem 0.55rem;
    background: linear-gradient(180deg, rgba(236, 254, 255, 0.65) 0%, rgba(255, 255, 255, 0.9) 100%);
  }

  .nav-desktop {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 0.3rem 0.5rem;
    min-width: 0;
    padding-inline: 0.35rem;
    padding-bottom: 4px;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scroll-padding-inline: 1rem;
  }

  .nav-desktop::-webkit-scrollbar {
    height: 5px;
  }

  .nav-desktop::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--color-ocean) 40%, transparent);
    border-radius: 4px;
  }

  .nav-item {
    position: relative;
    flex-shrink: 0;
  }

  .nav-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    flex-shrink: 0;
    color: #fff;
    box-shadow: 0 3px 12px rgba(14, 116, 144, 0.24);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .nav-item--map .nav-icon-wrap {
    background: linear-gradient(145deg, #0e7490 0%, #155e75 100%);
  }

  .nav-item--store .nav-icon-wrap {
    background: linear-gradient(145deg, #e11d48 0%, #f43f5e 100%);
    box-shadow: 0 4px 14px rgba(244, 63, 94, 0.35);
  }

  .nav-item--shield .nav-icon-wrap {
    background: linear-gradient(145deg, #059669 0%, #047857 100%);
    box-shadow: 0 4px 14px rgba(5, 150, 105, 0.3);
  }

  .nav-item--globe .nav-icon-wrap {
    background: linear-gradient(145deg, #d97706 0%, #b45309 100%);
    box-shadow: 0 4px 14px rgba(217, 119, 6, 0.35);
  }

  .nav-icon-wrap--cta {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(145deg, #fb7185 0%, #e11d48 100%);
    color: #fff;
    box-shadow: 0 3px 12px rgba(244, 63, 94, 0.32);
  }

  .nav-top {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.48rem;
    min-height: 42px;
    padding: 0.4rem 0.55rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    border-radius: var(--radius-md);
    text-align: left;
    line-height: 1.2;
    max-width: 152px;
    border: 1px solid transparent;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .nav-top:hover {
    color: var(--color-ocean-dark);
    background: color-mix(in srgb, var(--color-ocean-light) 12%, #fff);
    border-color: color-mix(in srgb, var(--color-ocean-light) 35%, transparent);
    box-shadow: 0 4px 18px rgba(14, 116, 144, 0.08);
  }

  .nav-top:hover .nav-icon-wrap {
    transform: translateY(-1px);
  }

  .nav-top-main {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 0.25rem;
    min-width: 0;
    flex: 1;
  }

  .nav-top-text {
    flex: 1;
    min-width: 0;
    font-size: 0.72rem;
    line-height: 1.28;
    font-weight: 600;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .nav-chevron {
    flex-shrink: 0;
    margin-top: 0.1rem;
    opacity: 0.5;
    color: var(--color-ocean-mid);
  }

  .submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 300px;
    max-width: min(380px, 92vw);
    max-height: 70vh;
    overflow-y: auto;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ocean-light) 28%, var(--color-border));
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 0.45rem 0;
    z-index: 60;
  }

  .submenu a {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    padding: 0.55rem 1rem 0.55rem 0.85rem;
    font-size: 0.84rem;
    color: var(--color-ink);
    line-height: 1.4;
    border-left: 3px solid transparent;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .submenu-dot {
    display: block;
    width: 6px;
    height: 6px;
    margin-top: 0.4rem;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--color-ocean-light);
  }

  .submenu a:hover {
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-ocean-light) 18%, transparent), transparent);
    color: var(--color-ocean-dark);
    border-left-color: var(--color-ocean);
  }

  .submenu a:hover .submenu-dot {
    background: var(--color-ocean);
  }

  .nav-item:hover .submenu,
  .nav-item:focus-within .submenu {
    display: block;
  }

  .nav-cta {
    display: flex;
    flex-direction: row;
    align-items: center;
    align-self: center;
    flex-shrink: 0;
    gap: 0.45rem;
    min-height: 42px;
    height: fit-content;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
    padding: 0.4rem 0.75rem 0.4rem 0.42rem;
    white-space: nowrap;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-coral) 92%, #fff) 0%, var(--color-coral) 100%);
    box-shadow: 0 4px 14px rgba(244, 63, 94, 0.3);
    border: 1px solid color-mix(in srgb, var(--color-coral) 40%, transparent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .nav-cta:hover {
    background: linear-gradient(135deg, var(--color-coral) 0%, #be123c 100%);
    color: #fff;
    box-shadow: 0 6px 22px rgba(244, 63, 94, 0.4);
    transform: translateY(-1px);
  }

  .nav-mobile {
    padding: 0.75rem clamp(1.25rem, 4vw, 2rem) 1.25rem;
    border-top: 1px solid var(--color-border);
    background: #fff;
    max-height: min(70vh, 520px);
    overflow-y: auto;
  }

  .nav-mobile[hidden] {
    display: none;
  }

  .mobile-group {
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-group summary {
    list-style: none;
    padding: 0.75rem 0;
    font-weight: 600;
    cursor: pointer;
    color: var(--color-ocean-dark);
  }

  .mobile-group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-summary-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .nav-icon-wrap--mobile {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    color: #fff;
    box-shadow: 0 4px 12px rgba(14, 116, 144, 0.22);
  }

  .mobile-group--map .nav-icon-wrap--mobile {
    background: linear-gradient(145deg, #0e7490 0%, #155e75 100%);
  }

  .mobile-group--store .nav-icon-wrap--mobile {
    background: linear-gradient(145deg, #e11d48 0%, #f43f5e 100%);
    box-shadow: 0 4px 12px rgba(244, 63, 94, 0.28);
  }

  .mobile-group--shield .nav-icon-wrap--mobile {
    background: linear-gradient(145deg, #059669 0%, #047857 100%);
    box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);
  }

  .mobile-group--globe .nav-icon-wrap--mobile {
    background: linear-gradient(145deg, #d97706 0%, #b45309 100%);
    box-shadow: 0 4px 12px rgba(217, 119, 6, 0.28);
  }

  .mobile-summary-text {
    flex: 1;
    line-height: 1.3;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .mobile-group ul {
    padding: 0 0 0.85rem 0;
    margin-left: calc(42px + 0.75rem);
    border-left: 2px solid color-mix(in srgb, var(--color-ocean-light) 45%, transparent);
  }

  .mobile-group a {
    display: block;
    padding: 0.45rem 0 0.45rem 0.55rem;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  .mobile-form-link,
  .mobile-wa {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
    font-weight: 600;
  }

  .nav-icon-wrap--mobile-sm {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    flex-shrink: 0;
  }

  .mobile-wa {
    color: #128c7e;
  }

  /* Desktop large : 2 lignes + menu visible */
  @media (min-width: 1200px) {
    .header-nav-desktop {
      display: block;
    }

    .menu-toggle {
      display: none;
    }

    .nav-mobile {
      display: none !important;
    }
  }

  /* Tablette / petit desktop : menu hamburger, pas de 2e ligne */
  @media (max-width: 1199px) {
    .header-nav-desktop {
      display: none !important;
    }
  }
</style>
