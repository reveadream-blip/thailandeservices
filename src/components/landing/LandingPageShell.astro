---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { CONTACT } from '../../config'
import { getLandingSeoFields, type LandingVariant } from '../../i18n/landing-seo'
import { translations, type Lang } from '../../i18n/translations'
import { rewriteInternalLinks } from '../../lib/internal-links'
import { getLandingHreflangAlternates, landingPath } from '../../lib/landing-paths'
import { contactPagePath, homePath } from '../../lib/locale-path'
import { absoluteUrl, buildWebPageSchemaGraph, truncateMeta } from '../../lib/seo'

export interface Props {
  lang: Lang
  variant: LandingVariant
}

const { lang, variant } = Astro.props
const fields = getLandingSeoFields(variant, lang)
const t = translations[lang]
const canonicalPath = landingPath(variant, lang)
const pageUrl = absoluteUrl(canonicalPath)
const homeHref = homePath(lang)
const bodyHtml = rewriteInternalLinks(fields.bodyHtml, lang)
const metaDescription = truncateMeta(fields.metaDescription, 160)

const jsonLdExtra = buildWebPageSchemaGraph({
  name: fields.jsonLdName,
  description: metaDescription,
  url: pageUrl,
  inLanguage: lang === 'fr' ? 'fr-FR' : lang === 'en' ? 'en-US' : 'th-TH',
  breadcrumbHomeName: t.articlePage.home,
  breadcrumbHomeUrl: absoluteUrl(homeHref),
  breadcrumbCurrentName: fields.breadcrumbCurrent,
})
---

<BaseLayout
  lang={lang}
  fullDocumentTitle={fields.documentTitle}
  metaDescription={metaDescription}
  canonicalPath={canonicalPath}
  hreflangAlternates={getLandingHreflangAlternates(variant)}
  jsonLdExtra={jsonLdExtra}
>
  <div class="landing-page">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.articlePage.breadcrumbLabel}>
        <a href={homeHref}>{t.articlePage.home}</a>
        <span class="bc-sep" aria-hidden="true">/</span>
        <span class="bc-current">{fields.breadcrumbCurrent}</span>
      </nav>

      <header class="landing-header">
        <h1>{fields.pageH1}</h1>
        <p class="landing-lead">{fields.lead}</p>
        <div class="landing-cta-row">
          <a href={CONTACT.whatsappLink} class="btn btn-whatsapp" target="_blank" rel="noopener">
            WhatsApp
          </a>
          <a href={contactPagePath(lang)} class="btn btn-primary">
            {t.contactPage.breadcrumbContact}
          </a>
        </div>
      </header>

      <div class="landing-seo wp-import" set:html={bodyHtml} />
    </div>
  </div>
</BaseLayout>

<style>
  .landing-page {
    padding-block: clamp(2rem, 5vw, 3.5rem);
    background: var(--color-cream);
    min-height: 50vh;
  }

  .breadcrumb {
    font-size: 0.88rem;
    margin-bottom: 1.25rem;
    color: var(--color-ink-muted);
  }

  .breadcrumb a {
    color: var(--color-ocean);
    font-weight: 500;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .bc-sep {
    margin-inline: 0.35rem;
  }

  .bc-current {
    color: var(--color-ink-soft);
  }

  .landing-header {
    max-width: 52rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .landing-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 4vw, 2.15rem);
    color: var(--color-ocean);
    line-height: 1.2;
    margin-bottom: 0.85rem;
  }

  .landing-lead {
    font-size: 1.1rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .landing-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .landing-seo {
    max-width: 52rem;
  }

  .landing-seo :global(.landing-seo-body p) {
    color: var(--color-ink-soft);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .landing-seo :global(.landing-seo-body h2) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-ocean);
    margin: 1.75rem 0 0.75rem;
  }

  .landing-seo :global(.landing-seo-body ul) {
    margin: 0 0 1.25rem 1.25rem;
    color: var(--color-ink-soft);
    line-height: 1.65;
  }

  .landing-seo :global(.landing-seo-body a) {
    color: var(--color-ocean);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
