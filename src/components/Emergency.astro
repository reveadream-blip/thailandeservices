---
import { translations, type Lang } from '../i18n/translations'
import { CONTACT, WP_PAGES, contactFormHref } from '../config'
import { localePath } from '../lib/locale-path'

export interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = translations[lang]
const f = t.emergency.features
---

<section id="emergency" class="section emergency-block">
  <div class="container">
    <header class="section-head" data-reveal>
      <h2>{t.emergency.title}</h2>
      <p class="intro">{t.emergency.description}</p>
    </header>

    <div class="feature-cards">
      <article class="feature-card" data-reveal>
        <div class="feature-bg" style={`background-image:url('/images/feature-bg-urgence.jpg')`}></div>
        <div class="feature-inner">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
              <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1s-.5-.2-.6.2c-.2.3-.7 1-.9 1.2s-.3.2-.6.1c-.3-.2-1.2-.5-2.3-1.4-.8-.7-1.4-1.6-1.6-1.9s0-.4.1-.6c.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5s0-.4 0-.5-.6-1.5-.9-2.1c-.2-.5-.5-.4-.6-.4h-.6c-.2 0-.5 0-.8.3s-1 1-1 2.4 1 2.8 1.2 3 2.1 3.2 5 4.5c.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.2-.1-.4-.2-.6-.4zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.3c1.4.8 3.1 1.2 4.8 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z" />
            </svg>
          </span>
          <h3>{f.urgent.title}</h3>
          <p>{f.urgent.desc}</p>
          <a href={CONTACT.whatsappLink} target="_blank" rel="noopener" class="feature-link">
            {f.urgent.linkLabel}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <article class="feature-card" data-reveal style="animation-delay:0.08s">
        <div class="feature-bg" style={`background-image:url('/images/feature-bg-entreprise.jpg')`}></div>
        <div class="feature-inner">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </span>
          <h3>{f.business.title}</h3>
          <p>{f.business.desc}</p>
          <a href={contactFormHref(lang)} class="feature-link">
            {f.business.linkLabel}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <article class="feature-card" data-reveal style="animation-delay:0.16s">
        <div class="feature-bg feature-bg--consulat" style={`background-image:url('/images/consulat.png')`}></div>
        <div class="feature-inner">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </span>
          <h3>{f.consulate.title}</h3>
          {f.consulate.desc && <p>{f.consulate.desc}</p>}
          <a href={localePath(lang, WP_PAGES.consulat)} class="feature-link">
            {f.consulate.linkLabel}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    </div>

    <div class="emergency-cta-bar" data-reveal>
      <a href={CONTACT.whatsappLink} target="_blank" rel="noopener" class="btn btn-whatsapp btn-big">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
          <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1s-.5-.2-.6.2c-.2.3-.7 1-.9 1.2s-.3.2-.6.1c-.3-.2-1.2-.5-2.3-1.4-.8-.7-1.4-1.6-1.6-1.9s0-.4.1-.6c.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5s0-.4 0-.5-.6-1.5-.9-2.1c-.2-.5-.5-.4-.6-.4h-.6c-.2 0-.5 0-.8.3s-1 1-1 2.4 1 2.8 1.2 3 2.1 3.2 5 4.5c.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.2-.1-.4-.2-.6-.4zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.3c1.4.8 3.1 1.2 4.8 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z" />
        </svg>
        {t.emergency.cta}
      </a>
      <a href={CONTACT.telHref} class="phone-link">{CONTACT.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .emergency-block {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background: linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--color-coral) 4%, #fff) 100%);
  }

  .section-head {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }

  .section-head h2 {
    font-family: var(--font-display);
    background: linear-gradient(135deg, var(--color-ocean-dark) 0%, var(--color-ocean-mid) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .feature-cards {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 900px) {
    .feature-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 280px;
    box-shadow: var(--shadow-md);
  }

  .feature-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.02);
  }

  .feature-bg--consulat {
    background-size: cover;
    background-position: center top;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 47, 73, 0.12) 0%, rgba(14, 83, 110, 0.9) 100%);
    z-index: 1;
  }

  .feature-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    min-height: 280px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: #fff;
  }

  .feature-icon {
    color: #fde68a;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.35));
    margin-bottom: 0.75rem;
  }

  .feature-inner h3 {
    color: #fff;
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }

  .feature-inner p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
    line-height: 1.55;
    flex-grow: 1;
    margin-bottom: 1rem;
  }

  .feature-link {
    font-weight: 700;
    color: #fef08a;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }

  .feature-link:hover {
    color: #fff;
  }

  .emergency-cta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--gradient-ocean);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-ocean), 0 4px 0 rgba(8, 51, 68, 0.35);
    border: 1px solid color-mix(in srgb, var(--color-ocean-light) 40%, transparent);
  }

  .btn-big {
    padding: 1rem 1.75rem;
    font-size: 1.02rem;
  }

  .phone-link {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffd6a5;
    letter-spacing: 0.03em;
  }

  .phone-link:hover {
    color: #fff;
  }
</style>
