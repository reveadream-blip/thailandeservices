---
import { translations, type Lang } from '../i18n/translations'
import { CONTACT, SITE, contactFormHref } from '../config'
import { FOOTER_ARCHIVES } from '../data/navigation'

export interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = translations[lang]
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <strong>{SITE.name}</strong>
      <p>{t.footer.tagline}</p>
      <p class="muted">📍 {t.footer.madeIn}</p>
    </div>

    <div class="footer-links">
      <h4>{t.footer.contactBlockTitle}</h4>
      <a href={contactFormHref(lang)}>{t.nav.contactForm}</a>
      <a href={CONTACT.whatsappLink} target="_blank" rel="noopener">
        {t.footer.byWhatsapp} · {CONTACT.phoneDisplay}
      </a>
    </div>

    <div class="footer-links">
      <h4>{t.footer.moreInfo}</h4>
      <div class="social-row">
        <a href={CONTACT.whatsappLink} target="_blank" rel="noopener" aria-label="WhatsApp" class="social social-wa">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1s-.5-.2-.6.2c-.2.3-.7 1-.9 1.2s-.3.2-.6.1c-.3-.2-1.2-.5-2.3-1.4-.8-.7-1.4-1.6-1.6-1.9s0-.4.1-.6c.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5s0-.4 0-.5-.6-1.5-.9-2.1c-.2-.5-.5-.4-.6-.4h-.6c-.2 0-.5 0-.8.3s-1 1-1 2.4 1 2.8 1.2 3 2.1 3.2 5 4.5c.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.2-.1-.4-.2-.6-.4zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.3c1.4.8 3.1 1.2 4.8 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z" />
          </svg>
        </a>
        <a href={CONTACT.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="social social-fb">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
        </a>
        <a href={CONTACT.youtubeFooterVideo} target="_blank" rel="noopener" aria-label="YouTube" class="social social-yt">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
          </svg>
        </a>
      </div>
    </div>

    <div class="footer-links">
      <h4>{t.footer.archives}</h4>
      {FOOTER_ARCHIVES.map((a) => (
        <a href={a.href}>
          {a.label} ({a.count})
        </a>
      ))}
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <span>© {SITE.copyrightYear} {SITE.name}. {t.footer.rights}.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: linear-gradient(165deg, #0f3d52 0%, var(--color-ocean-dark) 45%, #0c1929 100%);
    color: #cbd5e1;
    padding-top: 3rem;
    margin-top: 0;
    box-shadow: 0 -12px 40px rgba(14, 116, 144, 0.15);
  }

  .footer::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-ocean-light), var(--color-coral), var(--color-gold));
    opacity: 0.9;
  }

  .footer-inner {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    padding-bottom: 2.5rem;
  }

  @media (min-width: 900px) {
    .footer-inner {
      grid-template-columns: 1.2fr 1fr 1fr 1fr;
    }
  }

  .footer-brand strong {
    display: block;
    color: #fff;
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 0.6rem;
  }

  .footer-brand p {
    color: #9fb2c0;
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .footer-brand .muted {
    color: #7a8fa0;
    font-size: 0.92rem;
  }

  .footer-links h4 {
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer-links a {
    display: block;
    color: #9fb2c0;
    padding-block: 0.28rem;
    font-size: 0.92rem;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--color-gold-light);
  }

  .social-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .social:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.15);
  }

  .social-wa {
    color: #25d366;
  }

  .social-fb {
    color: #1877f2;
  }

  .social-yt {
    color: #ff0000;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: 1.25rem;
    font-size: 0.84rem;
    color: #7a8fa0;
    text-align: center;
  }
</style>
