---
import { translations, type Lang } from '../i18n/translations'

export interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = translations[lang]

const partners = [
  {
    key: 'tammy' as const,
    image: '/images/tammy.jpg',
    fallbackEmoji: '👩',
  },
  {
    key: 'thomas' as const,
    image: '/images/thomas.jpg',
    fallbackEmoji: '👨',
  },
  {
    key: 'consulate' as const,
    image: '/images/consulat.png',
    fallbackEmoji: '🇫🇷',
  },
]
---

<section id="partners" class="section partners">
  <div class="container">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">{t.partners.subtitle}</span>
      <h2>{t.partners.title}</h2>
    </header>

    <div class="partners-grid">
      {partners.map((p, i) => (
        <article class="partner-card" data-reveal style={`animation-delay:${i * 0.1}s`}>
          <div class="partner-photo">
            <img
              src={p.image}
              alt={t.partners[p.key].name}
              loading="lazy"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <span class="photo-fallback" aria-hidden="true">{p.fallbackEmoji}</span>
          </div>
          <div class="partner-body">
            <h3>{t.partners[p.key].name}</h3>
            <p class="role">{t.partners[p.key].role}</p>
            <p class="desc">{t.partners[p.key].description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .partners {
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-ocean-light) 6%, transparent) 0%, transparent 100%);
  }

  .section-head {
    text-align: center;
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: 3.5rem;
  }

  .section-head h2 {
    font-family: var(--font-display);
    background: linear-gradient(135deg, var(--color-ocean-dark) 0%, var(--color-coral) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .partners-grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .partners-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .partner-card {
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid color-mix(in srgb, var(--color-ocean-light) 22%, var(--color-border));
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .partner-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg), 0 0 0 1px color-mix(in srgb, var(--color-coral) 22%, transparent);
  }

  .partner-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--color-sand) 0%, var(--color-sand-light) 100%);
    overflow: hidden;
  }

  .partner-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-fallback {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
    opacity: 0.5;
  }

  .partner-body {
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .partner-body h3 {
    font-family: var(--font-display);
    color: var(--color-ocean-dark);
    font-size: 1.3rem;
  }

  .role {
    color: var(--color-coral);
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .desc {
    font-size: 0.96rem;
    line-height: 1.65;
    font-style: italic;
    color: var(--color-ink-soft);
  }
</style>
