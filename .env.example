# Copier vers .env en local si besoin.
# Sur Cloudflare Pages : Settings → Environment variables → Production (et Preview)

# URL publique du site SANS slash final.
# Ex. prévisualisation Cloudflare : https://thailande-services.pages.dev
# Quand le domaine custom sera branché : https://thailande-services.fr
PUBLIC_SITE_URL=https://thailande-services.fr

# Formulaire de contact (Web3Forms) — https://web3forms.com
# Les messages arrivent à l’adresse configurée dans le tableau de bord Web3Forms pour cette clé
# (pas dans ce fichier). Mets-y thailandeservices.fr@gmail.com comme email de notification.
# Tu peux utiliser la MÊME clé pour le site (Pages) et pour le Worker du chatbot : une seule boîte Gmail.
PUBLIC_WEB3FORMS_ACCESS_KEY=YOUR-WEB3FORMS-ACCESS-KEY

# Chatbot (Worker Cloudflare dans worker/) — URL complète du endpoint POST
# Ex. https://thailandeservices.<votre-sousdomaine>.workers.dev/chatbot
PUBLIC_CHATBOT_API_URL=
